rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default deny all unknown paths
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSuperAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'raydiamond108@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // 1. Product Images: Publicly readable; writable ONLY by Super Administrator
    match /products/{fileName} {
      allow read: if true;
      allow write: if isSuperAdmin() &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    // 2. Customer Device Repair Photos: Readable only by device owner or Super Administrator
    // Writable only by authenticated customer linking to own UID
    match /repairs/{userId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == userId || isSuperAdmin());
      allow write: if request.auth != null && request.auth.uid == userId &&
        request.resource.size < 10 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }
  }
}
