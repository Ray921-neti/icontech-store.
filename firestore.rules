rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections and documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Primary administrator with absolute management authority
    function isPrimaryAdmin() {
      return isSignedIn() && 
        request.auth.token.email == 'raydiamond108@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    // Sole Super Administrator enforcement (no secondary staff accounts or customer elevation)
    function isStaffAdmin() {
      return isPrimaryAdmin();
    }

    // 1. Products catalog: Publicly viewable, operational staff / admin manageable
    match /products/{productId} {
      allow read: if true;
      allow write: if isStaffAdmin() && isValidId(productId);
    }

    // 2. Customer profiles: Readable and editable only by owner and authorized staff.
    // Customers cannot alter immutable fields (createdAt, uid) or elevate privileges.
    match /customers/{customerId} {
      allow get: if isSignedIn() && (isOwner(customerId) || isStaffAdmin()) && isValidId(customerId);
      allow list: if isStaffAdmin();
      
      allow create: if isOwner(customerId) && isValidId(customerId) &&
        request.resource.data.uid == customerId &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 128 &&
        request.resource.data.phone is string && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 32 &&
        request.resource.data.normalizedPhone is string &&
        request.resource.data.createdAt is string &&
        (!('email' in request.resource.data) || request.resource.data.email is string) &&
        (!('defaultAddress' in request.resource.data) || request.resource.data.defaultAddress is string) &&
        (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is string) &&
        request.resource.data.keys().hasOnly([
          'uid', 'name', 'phone', 'normalizedPhone', 'email', 'defaultAddress', 
          'role', 'createdAt', 'updatedAt'
        ]) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'customer') &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);

      allow update: if isValidId(customerId) && (
        isStaffAdmin() || (
          isOwner(customerId) &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.createdAt == resource.data.createdAt &&
          request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 128 &&
          request.resource.data.phone is string && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 32 &&
          request.resource.data.normalizedPhone is string &&
          (!('email' in request.resource.data) || request.resource.data.email is string) &&
          (!('defaultAddress' in request.resource.data) || request.resource.data.defaultAddress is string) &&
          (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is string) &&
          request.resource.data.keys().hasOnly([
            'uid', 'name', 'phone', 'normalizedPhone', 'email', 'defaultAddress', 
            'role', 'createdAt', 'updatedAt'
          ]) &&
          (!('role' in request.resource.data) || request.resource.data.role == 'customer') &&
          (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false)
        )
      );

      // Customer account deletion restricted to primary admin
      allow delete: if isPrimaryAdmin() && isValidId(customerId);
    }

    // 3. Customer orders: Strictly authenticated & owner/staff accessible.
    // Unauthenticated access and cross-customer reads are rejected.
    match /orders/{orderId} {
      allow get: if isSignedIn() && (isStaffAdmin() || resource.data.customerUid == request.auth.uid) && isValidId(orderId);
      allow list: if isSignedIn() && (isStaffAdmin() || resource.data.customerUid == request.auth.uid);
      
      // Customer creation: must be authenticated, link to own UID, and have valid fields
      allow create: if isSignedIn() &&
        isValidId(orderId) &&
        request.resource.data.id == orderId &&
        request.resource.data.customerUid == request.auth.uid &&
        request.resource.data.customerName is string && request.resource.data.customerName.size() > 0 && request.resource.data.customerName.size() <= 128 &&
        request.resource.data.customerPhone is string && request.resource.data.customerPhone.size() >= 8 && request.resource.data.customerPhone.size() <= 32 &&
        request.resource.data.deliveryMethod in ['delivery', 'pickup'] &&
        request.resource.data.paymentMethod in ['cash_on_delivery', 'bank_transfer', 'cash_on_pickup'] &&
        request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50 &&
        request.resource.data.subtotal is number && request.resource.data.subtotal > 0 &&
        request.resource.data.deliveryFee is number && request.resource.data.deliveryFee >= 0 &&
        request.resource.data.totalAmount is number && request.resource.data.totalAmount > 0 &&
        request.resource.data.orderStatus == 'pending' &&
        request.resource.data.paymentStatus in ['unpaid', 'pending_verification'] &&
        request.resource.data.createdAt is string &&
        (!('customerEmail' in request.resource.data) || request.resource.data.customerEmail is string) &&
        (!('deliveryAddress' in request.resource.data) || request.resource.data.deliveryAddress is string) &&
        (!('notes' in request.resource.data) || request.resource.data.notes is string) &&
        (!('paymentReference' in request.resource.data) || request.resource.data.paymentReference is string) &&
        (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is string) &&
        request.resource.data.keys().hasOnly([
          'id', 'customerUid', 'customerName', 'customerPhone', 'customerEmail', 
          'deliveryMethod', 'deliveryAddress', 'items', 'subtotal', 'deliveryFee', 
          'totalAmount', 'paymentMethod', 'paymentStatus', 'paymentReference', 
          'orderStatus', 'notes', 'createdAt', 'updatedAt'
        ]);

      // Staff and admin can update order status and verify payment
      allow update: if isStaffAdmin() && isValidId(orderId);

      // Financial record deletion restricted to primary admin
      allow delete: if isPrimaryAdmin() && isValidId(orderId);
    }

    // 4. Gadget repairs: Strictly authenticated & owner/staff accessible.
    // Unauthenticated reads and cross-customer reads are rejected.
    match /repairs/{repairId} {
      allow get: if isSignedIn() && (isStaffAdmin() || resource.data.customerUid == request.auth.uid) && isValidId(repairId);
      allow list: if isSignedIn() && (isStaffAdmin() || resource.data.customerUid == request.auth.uid);

      // Customer creation: must be authenticated and link repair to own auth UID
      allow create: if isSignedIn() &&
        isValidId(repairId) &&
        request.resource.data.id == repairId &&
        request.resource.data.customerUid == request.auth.uid &&
        request.resource.data.customerName is string && request.resource.data.customerName.size() > 0 && request.resource.data.customerName.size() <= 128 &&
        request.resource.data.customerPhone is string && request.resource.data.customerPhone.size() >= 8 && request.resource.data.customerPhone.size() <= 32 &&
        request.resource.data.gadgetType is string && request.resource.data.gadgetType.size() > 0 && request.resource.data.gadgetType.size() <= 64 &&
        request.resource.data.brandModel is string && request.resource.data.brandModel.size() > 0 && request.resource.data.brandModel.size() <= 128 &&
        request.resource.data.faultCategory is string && request.resource.data.faultCategory.size() > 0 && request.resource.data.faultCategory.size() <= 128 &&
        request.resource.data.faultDescription is string && request.resource.data.faultDescription.size() > 0 && request.resource.data.faultDescription.size() <= 1000 &&
        request.resource.data.repairStatus == 'Received' &&
        (!('paymentStatus' in request.resource.data) || request.resource.data.paymentStatus == 'unpaid') &&
        (!('quotedPrice' in request.resource.data) || request.resource.data.quotedPrice == 0) &&
        (!('diagnosticNotes' in request.resource.data) || request.resource.data.diagnosticNotes == '') &&
        (!('customerEmail' in request.resource.data) || request.resource.data.customerEmail is string) &&
        (!('passcodeProvided' in request.resource.data) || request.resource.data.passcodeProvided is string) &&
        (!('photoUrl' in request.resource.data) || request.resource.data.photoUrl is string) &&
        (!('estimatedCompletion' in request.resource.data) || request.resource.data.estimatedCompletion is string) &&
        request.resource.data.createdAt is string &&
        (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is string) &&
        request.resource.data.keys().hasOnly([
          'id', 'customerUid', 'customerName', 'customerPhone', 'customerEmail', 
          'gadgetType', 'brandModel', 'faultCategory', 'faultDescription', 
          'photoUrl', 'passcodeProvided', 'repairStatus', 'quotedPrice', 
          'diagnosticNotes', 'estimatedCompletion', 'paymentStatus', 
          'createdAt', 'updatedAt'
        ]);

      // Technicians and staff can diagnose, update status, and quote prices
      allow update: if isStaffAdmin() && isValidId(repairId);

      // Deletion restricted to primary admin
      allow delete: if isPrimaryAdmin() && isValidId(repairId);
    }

    // 5. Admins registry: only primary administrator can manage authorized identities
    match /admins/{adminId} {
      allow read: if isPrimaryAdmin() && isValidId(adminId);
      allow create, update, delete: if isPrimaryAdmin() && 
        isValidId(adminId) &&
        (request.method == 'delete' || (
          request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'role', 'createdAt', 'updatedAt']) &&
          request.resource.data.uid == adminId &&
          request.resource.data.email is string &&
          request.resource.data.role in ['super_admin']
        ));
    }

    // 6. Business Approval Requests: Super Administrator personal sign-off queue
    match /approvals/{approvalId} {
      allow get, list: if isPrimaryAdmin() && isValidId(approvalId);
      
      // Super Admin can create any approval request.
      // Customers can ONLY create approval requests for their own orders and repair bookings.
      // Customers are strictly forbidden from creating administrative requests (pricing, products, stock, settings, cancellations).
      allow create: if isValidId(approvalId) && (
        isPrimaryAdmin() || (
          isSignedIn() &&
          request.resource.data.id == approvalId &&
          request.resource.data.status == 'pending' &&
          request.resource.data.requestedBy == request.auth.uid &&
          (
            (request.resource.data.type in ['order_confirmation', 'payment_verification'] && request.resource.data.targetCollection == 'orders') ||
            (request.resource.data.type in ['repair_quote'] && request.resource.data.targetCollection == 'repairs')
          ) &&
          !('reviewedAt' in request.resource.data) &&
          !('reviewedBy' in request.resource.data) &&
          !('rejectionReason' in request.resource.data)
        )
      );

      // Only Super Admin can approve, reject, execute, modify, or delete approval requests
      allow update, delete: if isPrimaryAdmin() && isValidId(approvalId);
    }

    // 7. Activity & Security Logs: Immutable audit log stream accessible only to Super Admin
    match /activity_logs/{logId} {
      allow get, list: if isPrimaryAdmin() && isValidId(logId);
      allow create: if isPrimaryAdmin() && isValidId(logId) &&
        request.resource.data.id == logId &&
        request.resource.data.timestamp is string &&
        request.resource.data.actorEmail is string &&
        request.resource.data.action is string;
      allow update, delete: if false; // strictly immutable audit trail
    }

    // 8. Business Settings: Publicly readable store details; editable exclusively by Super Admin
    match /business_settings/{settingId} {
      allow get, list: if true;
      allow write: if isPrimaryAdmin() && isValidId(settingId);
    }
  }
}
